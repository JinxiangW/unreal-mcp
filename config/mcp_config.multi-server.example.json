{
  "_comment": "Recommended multi-server setup: slim Unreal discovery server + external RenderDoc analysis. Add Unreal domain servers from mcp_config.slim-domains.example.json as needed.",
  "mcpServers": {
    "unreal-mcp": {
      "command": "python",
      "args": ["-m", "unreal_mcp.slim_server"],
      "cwd": "D:/ue-mcp/unreal-mcp",
      "env": {
        "UE_HOST": "127.0.0.1",
        "UE_PORT": "55557",
        "UE_PROJECT_PATH": "D:/UnrealProjects/MyToon/MyToon.uproject"
      }
    },
    "renderdoc-mcp": {
      "command": "uv",
      "args": ["--directory", "D:/renderdoc/renderdoc-mcp", "run", "renderdoc-mcp", "run-mcp"],
      "env": {}
    }
  }
}
