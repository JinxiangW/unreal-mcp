{
  "_comment": "Default single-server config. Exposes all Unreal domain tools through unreal_mcp.server, including material_graph tools. Use unreal_orchestrator.server only as an optional routing/discovery entrypoint.",
  "mcpServers": {
    "unreal-mcp": {
      "command": "python",
      "args": ["-m", "unreal_mcp.server"],
      "cwd": "D:/ue-mcp/unreal-mcp",
      "env": {
        "UE_HOST": "127.0.0.1",
        "UE_PORT": "55557",
        "UE_PROJECT_PATH": "D:/UnrealProjects/MyToon/MyToon.uproject",
        "UE_ENGINE_ROOT": "D:/UnrealEngines/UnrealEngine5_6/Engine",
        "UE_EDITOR_EXE": "D:/UnrealEngines/UnrealEngine5_6/Engine/Binaries/Win64/UnrealEditor.exe",
        "UE_EDITOR_CMD": "D:/UnrealEngines/UnrealEngine5_6/Engine/Binaries/Win64/UnrealEditor-Cmd.exe"
      }
    }
  }
}
