{
  "_comment": "Recommended: unreal-mcp (all UE domain tools) + renderdoc-mcp (external RenderDoc analysis). Add unreal_orchestrator.server separately only when optional routing/discovery is needed.",
  "mcpServers": {
    "unreal-mcp": {
      "command": "python",
      "args": ["-m", "unreal_mcp.server"],
      "cwd": "D:/ue-mcp/unreal-mcp",
      "env": {
        "UE_HOST": "127.0.0.1",
        "UE_PORT": "55557",
        "UE_PROJECT_PATH": "D:/UnrealProjects/MyToon/MyToon.uproject"
      }
    },
    "renderdoc-mcp": {
      "command": "uv",
      "args": ["--directory", "D:/renderdoc/renderdoc-mcp", "run", "renderdoc-mcp", "run-mcp"],
      "env": {}
    }
  }
}
